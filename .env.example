# ==========================================
# KCC ONLINE SHOP - ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# 1. CORE APPLICATION & GEMINI API KEYS
# ------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI assistant features.
# Automatically injected by AI Studio at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Automatically injected by AI Studio at runtime.
APP_URL="https://your-app-url.run.app"

# ------------------------------------------
# 2. SHOPIFY STOREFRONT API (Client & Server)
# ------------------------------------------
# VITE_SHOPIFY_STORE_DOMAIN: Your Shopify store domain (e.g., myshop.myshopify.com)
VITE_SHOPIFY_STORE_DOMAIN="your-shop-name.myshopify.com"

# VITE_SHOPIFY_STOREFRONT_TOKEN: Storefront API public access token created in Shopify admin apps
VITE_SHOPIFY_STOREFRONT_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------
# 3. WOOCOMMERCE REST API (Server Proxy)
# ------------------------------------------
# VITE_WOOCOMMERCE_API_URL: Your WordPress / WooCommerce site base URL
VITE_WOOCOMMERCE_API_URL="https://yourwordpresssite.com"

# VITE_WOOCOMMERCE_CONSUMER_KEY: WooCommerce Consumer Key (ck_xxxxxxxx)
VITE_WOOCOMMERCE_CONSUMER_KEY="ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# WOOCOMMERCE_CONSUMER_SECRET: WooCommerce Consumer Secret (cs_xxxxxxxx)
# CRITICAL: Keep secret server-side ONLY. Do NOT prefix with VITE_
WOOCOMMERCE_CONSUMER_SECRET="cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------
# 4. B2B SUPPLIER & DROPSHIPPING API KEYS (Server Proxy)
# ------------------------------------------
# ALIEXPRESS_APP_KEY: AliExpress Dropshipping Open Platform Key
ALIEXPRESS_APP_KEY="502910482"

# ALIEXPRESS_APP_SECRET: AliExpress Dropshipping Secret (Keep server-side only)
ALIEXPRESS_APP_SECRET="your_aliexpress_secret_here"

# CJ_DROPSHIP_ACCESS_TOKEN: CJ Dropshipping API Token
CJ_DROPSHIP_ACCESS_TOKEN="cj_token_live_xxxxxxxxxxxx"
